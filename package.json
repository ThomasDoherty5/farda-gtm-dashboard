{
  "name": "farda-gtm-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Farda GTM operations frontend (fixture-backed). See AGENTS.md and docs/intake.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:reference": "playwright test -c playwright.reference.config.ts",
    "manifest:generate": "node scripts/generate-route-manifest.mjs",
    "reference-server": "node tools/reference-server/run.mjs",
    "adapter:register": "node scripts/adapter-freeze-extract.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.15",
    "@tanstack/react-query": "5.105.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "25.0.1",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
