# Which adapter the app uses. Any other value is a startup error, never a demo fallback.
#   demo               = labeled synthetic fixtures, no live dispatch.
#   sandbox|production = the authenticated THO-283 adapter. Until THO-283 publishes its transport,
#                        these render an honest integration-pending state.
VITE_FARDA_ADAPTER=demo

# Base URL of the THO-283 authenticated adapter. Not yet published. Never put provider
# credentials, OAuth tokens or session secrets in any VITE_ variable (they ship to the browser).
VITE_FARDA_ADAPTER_BASE_URL=
