# Which adapter the app uses. "demo" = labeled synthetic fixtures, no live dispatch.
# "live" = the authenticated THO-283 adapter. Until THO-283 publishes its transport,
# "live" renders an honest integration-pending state; it never falls back to demo data.
VITE_FARDA_ADAPTER=demo

# Base URL of the THO-283 authenticated adapter. Not yet published. Never put provider
# credentials, OAuth tokens or session secrets in any VITE_ variable (they ship to the browser).
VITE_FARDA_ADAPTER_BASE_URL=
